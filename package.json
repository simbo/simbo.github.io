{
  "name": "simbo.github.io",
  "version": "3.4.0",
  "description": "My personal website.",
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de/)",
  "license": "MIT",
  "homepage": "https://simbo.de/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simbo/simbo.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/simbo/simbo.github.io/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "browserslist": "browserslist",
    "build": "tsc && vite build",
    "bundle-analyzer": "pnpx --yes vite-bundle-visualizer",
    "dev": "vite --no-clear-screen --host",
    "format:fix": "prettier --write .",
    "format": "prettier --check .",
    "lint:fix": "eslint -c .eslintrc.json --fix .",
    "lint": "eslint -c .eslintrc.json .",
    "ncu:latest": "ncu --interactive --target latest --reject='/^(@types/node)$/'",
    "ncu:minor": "ncu --interactive --target minor",
    "ncu:patch": "ncu --interactive --target patch",
    "postinstall": "pnpx --yes update-browserslist-db@latest",
    "preflight": "pnpm run lint && pnpm run format && pnpm run build",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "pnpm run dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@simbo/commitlint-config": "^2.0.0",
    "@types/node": "^24.19.0",
    "@types/nunjucks": "^3.2.6",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "autoprefixer": "^10.6.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unicorn": "^49.0.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.0",
    "nunjucks": "^3.2.4",
    "prettier": "^3.1.0",
    "rollup-plugin-html-minifier": "^2.0.0",
    "sass": "^1.105.0",
    "typescript": "5.2.2",
    "vite": "^5.0.5"
  }
}
