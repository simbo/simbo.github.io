{
  "name": "simbo.github.io",
  "version": "3.5.3",
  "description": "My personal website.",
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de/)",
  "license": "MIT",
  "homepage": "https://simbo.de/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simbo/simbo.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/simbo/simbo.github.io/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "browserslist": "browserslist",
    "browserslist:update": "pnpx --yes update-browserslist-db@latest",
    "build": "tsc && vite build",
    "bundle-analyzer": "pnpx --yes vite-bundle-visualizer",
    "check": "pnpm run check:eslint && pnpm run check:format && pnpm run check:types && pnpm run check:spelling",
    "check:eslint": "eslint --config ./eslint.config.ts --max-warnings 0 .",
    "check:format": "prettier --check .",
    "check:spelling": "cspell",
    "check:types": "tsc --noEmit --project tsconfig.node.json && tsc --noEmit --project tsconfig.browser.json",
    "clean": "pnpm run clean:coverage && pnpm run clean:node_modules",
    "clean:coverage": "rm -rf coverage",
    "clean:node_modules": "rm -rf node_modules",
    "fix:eslint": "pnpm run check:eslint --fix",
    "fix:format": "prettier --write .",
    "ncu:latest": "ncu --interactive --target latest --reject='/^(@types/node)$/'",
    "ncu:minor": "ncu --interactive --target minor",
    "ncu:patch": "ncu --interactive --target patch",
    "preflight": "pnpm run check && pnpm run test && pnpm run build",
    "prepare": "husky",
    "serve": "pnpm run serve:dev",
    "serve:coverage": "pnpx --yes http-server -c-1 ./coverage",
    "serve:dev": "vite --no-clear-screen --host",
    "serve:prod": "vite preview",
    "start": "pnpm run serve",
    "test": "vitest run --coverage",
    "test:ui": "pnpm run test:watch --ui",
    "test:watch": "vitest dev --coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@simbo/commitlint-config": "^2.0.0",
    "@simbo/cspell-config": "^2.1.0",
    "@simbo/eslint-config": "^3.2.0",
    "@simbo/package-json": "^1.0.0",
    "@simbo/prettier-config": "^3.0.1",
    "@simbo/stringify-error": "^2.0.0",
    "@simbo/tsconfig": "^2.0.0",
    "@simbo/vite-plugin-html-minifier": "^1.0.1",
    "@simbo/vite-plugin-nunjucks": "^1.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-check-updates": "^23.1.1",
    "prettier": "3.9.10",
    "sass": "^1.105.2",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
